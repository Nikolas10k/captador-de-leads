# ---------------------------------------------------------------
# Givance Tech · Captação de leads
# Copie para .env.local (dev) e cadastre as mesmas chaves na Vercel.
# ---------------------------------------------------------------

# URL pública do site (usada nos links de e-mail e metadados)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp da Givance com DDI, só números
NEXT_PUBLIC_WHATSAPP_NUMBER=5561996747738

# --- Supabase (Project Settings > API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave publicável (sb_publishable_...) ou a anon legada
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta / service_role. SÓ no servidor. Nunca exponha com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Ref do projeto, usado por `npm run gen:types`
SUPABASE_PROJECT_REF=

# Sal para o hash do IP no rate limit (qualquer texto longo e aleatório)
IP_HASH_SALT=

# --- Notificação por e-mail (Resend) ---
# Vazio = desligado
RESEND_API_KEY=
# Remetente de um domínio verificado no Resend
LEAD_NOTIFY_EMAIL_FROM="Givance Leads <leads@seudominio.com.br>"
# Um ou mais destinatários separados por vírgula
LEAD_NOTIFY_EMAIL_TO=

# --- Pontos de extensão de notificação (opcionais) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Webhook genérico (n8n, Make, Z-API, WhatsApp Cloud API...)
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# --- Rastreamento (vazio = desligado) ---
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
